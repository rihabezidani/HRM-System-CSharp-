@model IEnumerable<Rh.Models.Notification>
@{
    ViewData["Title"] = "Mes Notifications";
}

<div class="card shadow-sm border-0" style="border-radius: 15px;">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0" style="color: #5F4B8B;"><i class="fas fa-bell me-2"></i>Centre de Notifications</h5>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-bell-slash fa-3x mb-3 text-muted" style="opacity: 0.3;"></i>
                <p class="text-muted">Vous n'avez aucune notification pour le moment.</p>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var item in Model)
                {
                    <div class="list-group-item list-group-item-action p-3 border-0 @(item.EstLu ? "" : "bg-light")">
                        <div class="d-flex align-items-start">
                            <div class="p-2 rounded-circle me-3" style="background: @(item.EstLu ? "#f8f9fa" : "#F4A9CC"); color: @(item.EstLu ? "#6c757d" : "white");">
                                <i class="fas @(item.Message.Contains("validé") ? "fa-check" : "fa-info-circle")"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="mb-1 @(item.EstLu ? "text-muted" : "fw-bold")">Système HRM</h6>
                                    <small class="text-muted">@item.DateCreation.ToString("dd/MM HH:mm")</small>
                                </div>
                                <p class="mb-0 small @(item.EstLu ? "text-muted" : "text-dark")">@item.Message</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>