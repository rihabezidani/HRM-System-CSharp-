@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HRM - Connexion</title>

    <style>
        /* Définition de la palette Pantone */
        :root {
            --ultra-violet: #5F4B8B;
            --sparkling-grape: #7D4479;
            --mulberry: #A76B9A;
            --jacaranda: #8B9DC3;
            --rhapsody: #A592B5;
            --red-violet: #AD5D81;
            --chateau-rose: #D473A2;
            --prism-pink: #F4A9CC;
        }

        body {
            background-color: rgba(32, 26, 49, 1);
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
        }

        /* Vidéo d'arrière-plan */
        .video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -1;
        }

        .header {
            background: linear-gradient(90deg, rgba(244, 169, 204, 0.2), rgba(139, 157, 195, 0.3));
            backdrop-filter: blur(10px);
            padding: 15px;
            position: fixed;
            width: 100%;
            top: 3%;
            z-index: 999;
            border-bottom: 1px solid var(--prism-pink);
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: white;
        }

        .header-title {
            padding-left: 30px;
            letter-spacing: 5px;
            font-size: 1.5rem;
            font-weight: bold;
            text-shadow: 0 0 10px var(--ultra-violet);
        }

        .text-box {
            color: white;
            position: absolute;
            bottom: 15%; 
            left: 5%;
            display: flex;
            flex-direction: column;
            gap: 30px; 
        }

           
            .text-box p {
                font-size: 30px;
                margin: 0;
                padding: 0;
                line-height: 1;
            }

           
            .text-box h1 {
                font-size: 100px;
                line-height: 0.8; 
                margin: 0;
                padding: 0;
                color: transparent;
                -webkit-text-stroke: 3px var(--prism-pink);
                
                background: url('/images/back.png') repeat;
                -webkit-background-clip: text;
                background-clip: text;
                animation: backAnim 20s linear infinite;
            }

           
            .text-box h3 {
                font-size: 120px; 
                font-weight: 300;
                line-height: 0.9; 
                margin: 0;
                padding: 0;
                color: var(--jacaranda);
            }

        
        @@keyframes backAnim {
            from {
                background-position: 0 0;
            }

            to {
                background-position: 2000px 0;
            }
        }

        .text-box h3 {
            font-size: 80px; 
            font-weight: 80; 
            margin-left: 10px;
            color: var(--jacaranda);
            line-height: 1.1; 
        }
        
        .log-box {
            position: fixed;
            top: 55%;
            right: 90px;
            transform: translate(0, -50%);
            width: 500px;
            height: 520px;
            background: rgba(0, 0, 0, 0.4);
            border: 2px solid var(--prism-pink);
            backdrop-filter: blur(20px);
            box-shadow: 0 0 30px white, inset 0 0 15px white;
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

            .log-box h2 {
                color: white;
                font-size: 35px;
                margin-bottom: 30px;
                text-transform: uppercase;
                letter-spacing: 3px;
            }

       
        .input-field {
            width: 10cm;
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 40px;
            border: 2px solid var(--jacaranda);
            background: rgba(255, 255, 255, 0.05);
            color: white;
            outline: none;
            font-size: 1.1rem;
            transition: 0.4s;
        }

            .input-field:focus {
                border-color: var(--prism-pink);
                box-shadow: 0 0 15px var(--prism-pink);
                background: rgba(255, 255, 255, 0.1);
            }

            .input-field::placeholder {
                color: var(--rhapsody);
            }

        
        button {
            margin-top: 10px;
            width: 80%;
            height: 55px;
            background: linear-gradient(135deg, var(--ultra-violet), var(--sparkling-grape));
            border: none;
            outline: none;
            border-radius: 40px;
            cursor: pointer;
            font-size: 1.2em;
            color: white;
            font-weight: bold;
            box-shadow: 0 0 20px var(--ultra-violet);
            transition: 0.7s ease;
        }

            button:hover {
                transform: scale(1.05);
                box-shadow: 0 0 30px var(--prism-pink);
                filter: brightness(1.2);
            }

       
        #result {
            width: 350px;
            margin-top: 20px;
            padding: 10px;
            background-color: rgba(173, 93, 129, 0.2);
            border: 1px solid var(--red-violet);
            border-radius: 20px;
        }

            #result p {
                font-size: 14px;
                color: var(--prism-pink);
                margin: 0;
                text-align: center;
            }
    </style>
</head>
<body>
    <div class="header">
        <div class="header-content">
            <h1 class="header-title">HRM SYSTEM</h1>
        </div>
    </div>

    <section class="main">
        <div class="text-box">
            <h1>HR Management</h1>
            <p style="font-size: 50px; margin-left: 10px; color: var(--rhapsody);">Performance & Stratégie</p>


        </div>

        <div class="log-box">
            <form asp-controller="Account" asp-action="Login" method="post">
                <h2>Connexion</h2>

                <input type="email" name="email" class="input-field" placeholder="Email professionnel" required />
                <br>
                <input type="password" name="password" class="input-field" placeholder="Mot de passe" required />
                <br>

                <button type="submit">SE CONNECTER</button>
            </form>

            @if (ViewBag.Error != null)
            {
                <div id="result">
                    <p>@ViewBag.Error</p>
                </div>
            }
        </div>
    </section>

</body>
</html>