@model Rh.Models.Employe

<div class="container mt-4">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 850px; border-radius: 15px; overflow: hidden;">
        <div class="card-header text-white py-3" style="background: linear-gradient(135deg, var(--ultra-violet), var(--sparkling-grape));">
            <h4 class="mb-0">Fiche Collaborateur</h4>
        </div>
        <div class="card-body p-4 bg-white">
            <form asp-action="Edit">
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Matricule" class="form-label fw-bold" style="color: var(--ultra-violet);">Matricule</label>
                        <input asp-for="Matricule" class="form-control bg-light" style="border-radius: 8px;" readonly />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Nom" class="form-label fw-bold" style="color: var(--ultra-violet);"></label>
                        <input asp-for="Nom" class="form-control" style="border-radius: 8px;" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Prenom" class="form-label fw-bold" style="color: var(--ultra-violet);"></label>
                        <input asp-for="Prenom" class="form-control" style="border-radius: 8px;" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-bold" style="color: var(--ultra-violet);"></label>
                        <input asp-for="Email" class="form-control" style="border-radius: 8px;" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Poste" class="form-label fw-bold" style="color: var(--ultra-violet);"></label>
                        <input asp-for="Poste" class="form-control" style="border-radius: 8px;" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Departement" class="form-label fw-bold" style="color: var(--ultra-violet);">Département</label>
                        <select asp-for="Departement" class="form-select" style="border-radius: 8px;">
                            <option value="">-- Sélectionner un département --</option>
                            <option value="Ressources Humaines">Ressources Humaines</option>
                            <option value="Informatique">Informatique</option>
                            <option value="Finance">Finance</option>
                            <option value="Marketing">Marketing</option>
                            <option value="Opérations">Opérations</option>
                        </select>
                        <span asp-validation-for="Departement" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="SalaireBase" class="form-label fw-bold" style="color: var(--ultra-violet);">Salaire (DH)</label>
                        <input asp-for="SalaireBase" class="form-control text-end" type="number" step="0.01" style="border-radius: 8px;" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DateNaissance" class="form-label fw-bold" style="color: var(--ultra-violet);">Date de Naissance</label>
                        <input asp-for="DateNaissance" class="form-control" type="date" style="border-radius: 8px;" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DateEmbauche" class="form-label fw-bold" style="color: var(--ultra-violet);">Date d'Embauche</label>
                        <input asp-for="DateEmbauche" class="form-control" type="date" style="border-radius: 8px;" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Telephone" class="form-label fw-bold" style="color: var(--ultra-violet);">Téléphone</label>
                        <input asp-for="Telephone" class="form-control" style="border-radius: 8px;" />
                        <span asp-validation-for="Telephone" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Adresse" class="form-label fw-bold" style="color: var(--ultra-violet);"></label>
                        <textarea asp-for="Adresse" class="form-control" rows="2" style="border-radius: 8px;"></textarea>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Solde Congés</label>
                    @* Assurez-vous que le nom est bien JoursCongesRestants *@
                    <input name="JoursCongesRestants" value="@Model.JoursCongesRestants" class="form-control" type="number" />
                </div>
                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn text-white px-5 shadow-sm" style="background: var(--ultra-violet); border: none; border-radius: 10px;">Enregistrer</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4" style="border-radius: 10px;">Annuler</a>
                </div>
                
            </form>
        </div>
    </div>
</div>