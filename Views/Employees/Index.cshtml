@model IEnumerable<Rh.Models.Employe>

@{
    ViewData["Title"] = "Répertoire du Personnel";
}

<div class="container-fluid mt-4">
    <div class="card border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
        @* Header avec titre en Ultra Violet *@
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h4 class="mb-0 fw-bold" style="color: var(--ultra-violet);">Répertoire du Personnel</h4>
            <a asp-action="Create" class="btn text-white shadow-sm px-4" style="background: var(--ultra-violet); border: none; border-radius: 10px;">
                <i class="fas fa-plus me-1"></i> Ajouter un employé
            </a>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #F8F7FA;">
                        <tr>
                            <th class="ps-4 border-0" style="color: var(--ultra-violet);">Matricule</th>
                            <th class="border-0">Collaborateur</th>
                            <th class="border-0">Département / Poste</th>
                            <th class="text-center border-0">Solde Congés</th>
                            <th class="text-end border-0">Salaire de Base</th>
                            <th class="text-center border-0">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">@item.Matricule</td>
                                <td>
                                    <div class="fw-bold" style="color: #443D54;">@item.Nom @item.Prenom</div>
                                    <small class="text-muted">@item.Email</small>
                                </td>
                                <td>
                                    @* Badge département en Sparkling Grape *@
                                    <span class="badge text-white mb-1" style="background-color: var(--sparkling-grape);">@item.Departement</span><br />
                                    <small style="color: var(--ultra-violet); font-weight: 500;">@item.Poste</small>
                                </td>

                                <td class="text-center">
                                    @{
                                        // On garde les couleurs sémantiques pour l'alerte de solde
                                        var badgeClass = item.JoursCongesRestants <= 5 ? "bg-danger" :
                                        (item.JoursCongesRestants <= 15 ? "bg-warning text-dark" : "bg-success");
                                    }
                                    <span class="badge @badgeClass" style="min-width: 80px; padding: 8px; border-radius: 8px;">
                                        <i class="fas fa-calendar-alt me-1"></i> @item.JoursCongesRestants j
                                    </span>
                                </td>

                                <td class="text-end fw-bold" style="color: #443D54;">@item.SalaireBase.ToString("N2") DH</td>

                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        @* Bouton Edit en Jacaranda (bleu-violet doux) *@
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm shadow-sm text-white" style="background-color: var(--jacaranda); border: none;">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 6px;"
                                                    onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce collaborateur ?');">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    /* Effet de surbrillance au survol des lignes */
    .table-hover tbody tr:hover {
        background-color: rgba(95, 75, 139, 0.03);
    }

    thead th {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
        padding: 15px 10px !important;
    }

    .table td {
        padding: 15px 10px !important;
        border-color: #F1EFF5;
    }
</style>