@model Rh.Models.Employe

@{
    ViewData["Title"] = "Mon Profil";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 px-3">
        <div>
            @* Couleur Ultra Violet pour le titre *@
            <h3 class="fw-bold mb-0" style="color: var(--ultra-violet);">Bienvenue, @Model.Prenom !</h3>
            <p class="text-muted">Voici l'état récapitulatif de votre compte collaborateur.</p>
        </div>
        <span class="badge bg-white text-dark border p-2 shadow-sm" style="border-radius: 50px;">
            @* Icône en Ultra Violet *@
            <i class="fas fa-clock me-1" style="color: var(--ultra-violet);"></i> @DateTime.Now.ToString("dd MMMM yyyy")
        </span>
    </div>

    <div class="row mb-4">
        @* Carte Solde Congés - Bordure Ultra Violet *@
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 h-100" style="border-left-color: var(--ultra-violet) !important; border-radius: 12px;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: var(--ultra-violet);">Solde Congés</div>
                            <div class="h4 mb-0 fw-bold text-dark">@Model.JoursCongesRestants Jours</div>
                        </div>
                        <i class="fas fa-calendar-check fa-2x text-light-emphasis"></i>
                    </div>
                </div>
            </div>
        </div>

        @* Carte Département - Bordure Sparkling Grape *@
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 h-100" style="border-left-color: var(--sparkling-grape) !important; border-radius: 12px;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: var(--sparkling-grape);">Département</div>
                            <div class="h5 mb-0 fw-bold text-dark">@Model.Departement</div>
                        </div>
                        <i class="fas fa-building fa-2x text-light-emphasis"></i>
                    </div>
                </div>
            </div>
        </div>

        @* Carte Poste - Bordure Jacaranda *@
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 h-100" style="border-left-color: var(--jacaranda) !important; border-radius: 12px;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: var(--jacaranda);">Poste Actuel</div>
                            <div class="h5 mb-0 fw-bold text-dark">@Model.Poste</div>
                        </div>
                        <i class="fas fa-briefcase fa-2x text-light-emphasis"></i>
                    </div>
                </div>
            </div>
        </div>

        @* Carte ID - Bordure Chateau Rose *@
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 h-100" style="border-left-color: var(--chateau-rose) !important; border-radius: 12px;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: var(--chateau-rose);">ID Collaborateur</div>
                            <div class="h5 mb-0 fw-bold text-dark">@Model.Matricule</div>
                        </div>
                        <i class="fas fa-id-badge fa-2x text-light-emphasis"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row px-2">
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 15px;">
                <div class="card-header bg-white py-3 border-bottom">
                    @* Titre section en Ultra Violet *@
                    <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-info-circle me-2" style="color: var(--ultra-violet);"></i>Informations Personnelles</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle">
                            <tbody>
                                <tr>
                                    <td class="text-muted" style="width: 250px;">Email Professionnel</td>
                                    <td class="fw-bold">@Model.Email</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Numéro de Téléphone</td>
                                    <td class="fw-bold">@Model.Telephone</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Date d'Embauche</td>
                                    <td class="fw-bold">@Model.DateEmbauche?.ToString("dd/MM/yyyy")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Rémunération de Base</td>
                                    @* Texte salaire en Mulberry *@
                                    <td class="fw-bold" style="color: var(--mulberry);">@Model.SalaireBase.ToString("N2") DH</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 15px;">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-rocket me-2" style="color: var(--ultra-violet);"></i>Actions rapides</h5>
                </div>
                <div class="card-body d-grid gap-3 align-content-start">
                    @* Bouton Principal en Ultra Violet *@
                    <a asp-controller="Conges" asp-action="Demander" class="btn btn-lg shadow-sm text-white" style="background: var(--ultra-violet); border: none; border-radius: 10px;">
                        <i class="fas fa-plus-circle me-2"></i>Demander un Congé
                    </a>
                    @* Bouton Secondaire avec bordure Ultra Violet *@
                    <a asp-controller="Conges" asp-action="MesConges" class="btn btn-lg" style="border: 1px solid var(--ultra-violet); color: var(--ultra-violet); border-radius: 10px;">
                        <i class="fas fa-list-ul me-2"></i>Voir mes Demandes
                    </a>
                    <hr>
                    <div class="alert border-0 mb-0 py-2" style="background-color: #F8F7FA; border-radius: 10px;">
                        <small><i class="fas fa-lightbulb me-2" style="color: var(--ultra-violet);"></i>Besoin de modifier vos infos ? Contactez votre gestionnaire RH.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-xs {
        font-size: .75rem;
    }

    .card {
        transition: transform 0.2s ease;
    }

        .card:hover {
            transform: translateY(-3px);
        }
</style>