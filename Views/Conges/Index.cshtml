@model IEnumerable<Rh.Models.Conge>

@{
    ViewData["Title"] = "Gestion des Congés";
}

<div class="container-fluid mt-4">
    <div class="card border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
        @* Header avec icône et titre en Ultra Violet *@
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h4 class="mb-0 fw-bold" style="color: var(--ultra-violet);">
                <i class="fas fa-clipboard-list me-2"></i>Gestion des Demandes de Congés
            </h4>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    @* En-tête avec style Pantone *@
                    <thead style="background-color: #F8F7FA;">
                        <tr>
                            <th class="ps-4 border-0" style="color: var(--ultra-violet);">Employé</th>
                            <th class="border-0">Type</th>
                            <th class="border-0">Période</th>
                            <th class="text-center border-0">Durée</th>
                            <th class="text-center border-0">Statut</th>
                            <th class="text-center border-0">Actions de Validation</th>
                            <th class="text-center border-0">Suppr.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var duree = (item.DateFin - item.DateDebut).Days + 1;
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold" style="color: #443D54;">@(item.Employe?.Nom + " " + item.Employe?.Prenom)</div>
                                    <small class="text-muted">Demandé le @item.DateDemande.ToString("dd/MM/yyyy")</small>
                                </td>
                                <td>
                                    @* Badge type de congé en Jacaranda *@
                                    <span class="badge text-white" style="background-color: var(--jacaranda); font-weight: 500; border-radius: 6px;">
                                        @item.TypeConge
                                    </span>
                                </td>
                                <td>
                                    <div class="small">Du <span class="fw-bold" style="color: var(--ultra-violet);">@item.DateDebut.ToString("dd/MM/yyyy")</span></div>
                                    <div class="small">Au <span class="fw-bold" style="color: var(--ultra-violet);">@item.DateFin.ToString("dd/MM/yyyy")</span></div>
                                </td>
                                <td class="text-center fw-bold text-secondary">@duree j</td>
                                <td class="text-center">
                                    @{
                                        var badgeClass = item.Statut == "Approuvé" ? "bg-success" :
                                        item.Statut == "Refusé" ? "bg-danger" : "bg-warning text-dark";
                                    }
                                    <span class="badge @badgeClass" style="min-width: 85px; padding: 8px; border-radius: 8px;">@item.Statut</span>
                                </td>
                                <td class="text-center">
                                    @if (item.Statut == "En attente")
                                    {
                                        <div class="d-flex justify-content-center gap-2">
                                            @* Formulaire pour Approuver *@
                                            <form asp-action="Valider" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="statut" value="Approuvé" />
                                                <button type="submit" class="btn btn-success btn-sm px-3 shadow-sm" style="border-radius: 8px;">
                                                    <i class="fas fa-check me-1"></i> Valider
                                                </button>
                                            </form>

                                            @* Formulaire pour Refuser *@
                                            <form asp-action="Valider" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="statut" value="Refusé" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm px-3 shadow-sm" style="border-radius: 8px;">
                                                    <i class="fas fa-times me-1"></i> Refuser
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><i class="fas fa-lock me-1"></i>Traité</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Supprimer définitivement cet enregistrement ?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-link text-danger p-0">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    
    thead th {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
        padding: 15px 10px !important;
    }

    
    .table td {
        padding: 15px 10px !important;
        border-color: #F1EFF5;
    }

    
    .table-hover tbody tr:hover {
        background-color: rgba(95, 75, 139, 0.03);
    }

    
    .badge {
        transition: all 0.3s ease;
    }
</style>