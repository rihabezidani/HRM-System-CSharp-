@model IEnumerable<Rh.Models.Conge>

@{
    ViewData["Title"] = "Mes Demandes de Congés";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        @* Titre en Ultra Violet *@
        <h2 class="fw-bold" style="color: var(--ultra-violet);">
            <i class="fas fa-calendar-alt me-2"></i>Mes Demandes
        </h2>
        @* Bouton Nouvelle Demande en Ultra Violet *@
        <a asp-action="Demander" class="btn text-white shadow-sm px-4" style="background: var(--ultra-violet); border: none; border-radius: 10px;">
            <i class="fas fa-plus me-1"></i> Nouvelle Demande
        </a>
    </div>

    <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    @* En-tête avec fond gris clair *@
                    <thead style="background-color: #F8F7FA;">
                        <tr>
                            <th class="ps-4 border-0" style="color: var(--ultra-violet);">Dates</th>
                            <th class="border-0">Type</th>
                            <th class="border-0">Motif</th>
                            <th class="text-center border-0">Statut</th>
                            <th class="text-end pe-4 border-0">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    @* Couleur Ultra Violet pour la date de début *@
                                    <div class="fw-bold" style="color: var(--ultra-violet);">Du @item.DateDebut.ToShortDateString()</div>
                                    <div class="small text-muted">Au @item.DateFin.ToShortDateString()</div>
                                </td>
                                <td>
                                    <span class="badge" style="background-color: var(--jacaranda); color: white; border-radius: 6px;">
                                        @item.TypeConge
                                    </span>
                                </td>
                                <td class="text-truncate" style="max-width: 200px; color: #443D54;">
                                    @(string.IsNullOrEmpty(item.Motif) ? "-" : item.Motif)
                                </td>
                                <td class="text-center">
                                    @* Conservation des couleurs sémantiques pour les statuts *@
                                    @if (item.Statut == "Approuvé")
                                    {
                                        <span class="badge bg-success" style="padding: 8px 12px; border-radius: 8px;">
                                            <i class="fas fa-check-circle me-1"></i> Approuvé
                                        </span>
                                    }
                                    else if (item.Statut == "Refusé")
                                    {
                                        <span class="badge bg-danger" style="padding: 8px 12px; border-radius: 8px;">
                                            <i class="fas fa-times-circle me-1"></i> Refusé
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark" style="padding: 8px 12px; border-radius: 8px;">
                                            <i class="fas fa-clock me-1"></i> En attente
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (item.Statut == "En attente")
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"
                                           style="border-radius: 8px;"
                                           onclick="return confirm('Annuler cette demande ?')">
                                            <i class="fas fa-trash me-1"></i> Annuler
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
   
    thead th {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
        padding: 15px 10px !important;
    }

    .table td {
        padding: 15px 10px !important;
        border-color: #F1EFF5;
    }

  
    .table-hover tbody tr:hover {
        background-color: rgba(95, 75, 139, 0.03);
    }
</style>